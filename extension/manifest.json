{
  "manifest_version": 3,
  "name": "Substack Light Reader",
  "version": "0.5.0",
  "description": "Give dark Substack reading pages a light background. Local-only, no tracking. Independent community project.",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Substack Light Reader",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.substack.com/*",
        "https://letters.thedankoe.com/*",
        "https://www.lennysnewsletter.com/*",
        "https://www.noahpinion.blog/*",
        "https://newsletter.semianalysis.com/*",
        "https://newsletter.pragmaticengineer.com/*",
        "https://blog.bytebytego.com/*",
        "https://www.exponentialview.co/*",
        "https://www.news.aakashg.com/*",
        "https://www.newcomer.co/*",
        "https://www.generalist.com/*",
        "https://www.citriniresearch.com/*",
        "https://newsletter.doomberg.com/*",
        "https://www.blockedandreported.org/*"
      ],
      "exclude_matches": [
        "https://substack.com/*",
        "https://www.substack.com/*",
        "https://support.substack.com/*",
        "https://on.substack.com/*",
        "https://pages.substack.com/*",
        "https://status.substack.com/*",
        "https://api.substack.com/*",
        "https://app.substack.com/*",
        "https://admin.substack.com/*",
        "https://cdn.substack.com/*",
        "https://reader.substack.com/*",
        "https://go.substack.com/*",
        "https://help.substack.com/*",
        "https://developers.substack.com/*",
        "https://community.substack.com/*",
        "https://link.substack.com/*",
        "https://links.substack.com/*",
        "https://email.substack.com/*",
        "https://*/dashboard",
        "https://*/dashboard?*",
        "https://*/dashboard/*",
        "https://*/publish",
        "https://*/publish?*",
        "https://*/publish/*",
        "https://*/publisher",
        "https://*/publisher?*",
        "https://*/publisher/*",
        "https://*/editor",
        "https://*/editor?*",
        "https://*/editor/*",
        "https://*/edit",
        "https://*/edit?*",
        "https://*/edit/*",
        "https://*/settings",
        "https://*/settings?*",
        "https://*/settings/*",
        "https://*/account",
        "https://*/account?*",
        "https://*/account/*",
        "https://*/sign-in",
        "https://*/sign-in?*",
        "https://*/sign-in/*",
        "https://*/signin",
        "https://*/signin?*",
        "https://*/signin/*",
        "https://*/sign-up",
        "https://*/sign-up?*",
        "https://*/sign-up/*",
        "https://*/signup",
        "https://*/signup?*",
        "https://*/signup/*",
        "https://*/login",
        "https://*/login?*",
        "https://*/login/*",
        "https://*/logout",
        "https://*/logout?*",
        "https://*/logout/*",
        "https://*/auth",
        "https://*/auth?*",
        "https://*/auth/*",
        "https://*/oauth",
        "https://*/oauth?*",
        "https://*/oauth/*",
        "https://*/checkout",
        "https://*/checkout?*",
        "https://*/checkout/*",
        "https://*/subscribe",
        "https://*/subscribe?*",
        "https://*/subscribe/*",
        "https://*/payment",
        "https://*/payment?*",
        "https://*/payment/*",
        "https://*/payments",
        "https://*/payments?*",
        "https://*/payments/*",
        "https://*/billing",
        "https://*/billing?*",
        "https://*/billing/*",
        "https://*/api",
        "https://*/api?*",
        "https://*/api/*",
        "https://*/embed",
        "https://*/embed?*",
        "https://*/embed/*",
        "https://*/inbox",
        "https://*/inbox?*",
        "https://*/inbox/*",
        "https://*/chat",
        "https://*/chat?*",
        "https://*/chat/*",
        "https://*/welcome",
        "https://*/welcome?*",
        "https://*/welcome/*",
        "https://*/confirm",
        "https://*/confirm?*",
        "https://*/confirm/*",
        "https://*/unsubscribe",
        "https://*/unsubscribe?*",
        "https://*/unsubscribe/*",
        "https://*/verify",
        "https://*/verify?*",
        "https://*/verify/*",
        "https://*/redirect",
        "https://*/redirect?*",
        "https://*/redirect/*",
        "https://*/p/*/edit",
        "https://*/p/*/edit?*",
        "https://*/p/*/edit/*",
        "https://*/p/*/preview",
        "https://*/p/*/preview?*",
        "https://*/p/*/preview/*"
      ],
      "css": [
        "light-theme.css"
      ],
      "js": [
        "runtime.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "host_permissions": [
    "https://*.substack.com/*",
    "https://letters.thedankoe.com/*",
    "https://www.lennysnewsletter.com/*",
    "https://www.noahpinion.blog/*",
    "https://newsletter.semianalysis.com/*",
    "https://newsletter.pragmaticengineer.com/*",
    "https://blog.bytebytego.com/*",
    "https://www.exponentialview.co/*",
    "https://www.news.aakashg.com/*",
    "https://www.newcomer.co/*",
    "https://www.generalist.com/*",
    "https://www.citriniresearch.com/*",
    "https://newsletter.doomberg.com/*",
    "https://www.blockedandreported.org/*"
  ]
}
