{
  "manifest_version": 3,
  "name": "Substack Light Reader",
  "version": "0.5.0",
  "description": "Give dark Substack reading pages a light background. Local-only, no tracking. Independent community project.",
  "permissions": ["storage"],
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "Substack Light Reader",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "content_scripts": [{
    "matches": [],
    "exclude_matches": [],
    "css": ["light-theme.css"],
    "js": ["runtime.js", "content.js"],
    "run_at": "document_start",
    "all_frames": false
  }]
}
