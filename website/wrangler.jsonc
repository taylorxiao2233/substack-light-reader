{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "substacklight",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    { "pattern": "substacklight.com", "custom_domain": true }
  ]
}
